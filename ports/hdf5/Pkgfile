# Description: management of extremely large and complex data collections
# URL: https://www.hdfgroup.org/downloads/hdf5/
# Maintainer: Daryl Fonseca-Holt, wyatt at prairieturtle dot ca
# Depends on: gcc-fortran

name=hdf5
version=2.2.0
release=1
source=(https://github.com/HDFGroup/hdf5/archive/refs/tags/$version.tar.gz)
renames=($name-$version.tar.gz)

build() {
	cmake -B build -S $name-$version -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_BUILD_FORTRAN=ON \
		-D HDF5_ENABLE_ZLIB_SUPPORT=ON \
		-W no-dev

	cmake --build build
	DESTDIR=$PKG cmake --install build
}
